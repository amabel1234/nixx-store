{
  "buildCommand": "node artifacts/toko-wa/generate-index.mjs && pnpm --filter @workspace/toko-wa run build",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": "artifacts/toko-wa/dist/public",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}